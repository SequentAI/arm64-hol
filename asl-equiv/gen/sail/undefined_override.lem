(* Deterministic UNKNOWN values for the HOL4 export.

   Sail's default undefined_* functions choose nondeterministically, which the
   HOL4 state monad represents as sets of outcomes. Following the
   armv8.6-asl-snapshot HOL4 model, each UNKNOWN value is instead one fixed
   but unspecified value (HOL4 ARB), so execution stays deterministic and
   proofs cannot depend on which value an implementation picks.

   For Sail 0.17, whose concurrency-interface monad has no translation
   start/end type parameters. *)

open import Pervasives_extra
open import Sail2_values
open import Sail2_concurrency_interface

(* Based on Sail's test/exec/lbuild/undefined_override.lem_v1.

   Override the normal definitions for these to provide something
   executable and determinstic.

   The Lem files are compiled individually here, so we need to include
   the modules with the definitions that we're overriding to ensure a
   consistent renaming by Lem. *)

open import Sail2_undefined_concurrency_interface

val unknown : forall 'a. 'a
declare hol target_rep function unknown = `ARB`

val internal_pick : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'a 'e. list 'a -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'a 'e
let internal_pick l = return unknown

val undefined_bitvector : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'a 'e. Bitvector 'a => integer -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'a 'e
let undefined_bitvector n = return unknown

let undefined_bits = undefined_bitvector
val undefined_bit : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'e. unit -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval bitU 'e
let undefined_bit () = return unknown
val undefined_bool : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'e. unit -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval bool 'e
let undefined_bool () = return unknown
val undefined_string : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'e. unit -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval string 'e
let undefined_string () = return unknown
val undefined_int : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'e. unit -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval integer 'e
let undefined_int () = return unknown
val undefined_nat : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'e. unit -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval integer 'e
let undefined_nat () = return unknown
val undefined_real : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'e. unit -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval real 'e
let undefined_real () = return unknown
val undefined_range : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'e. integer -> integer -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval integer 'e
let undefined_range i j = return i
val undefined_atom : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'e. integer -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval integer 'e
let undefined_atom i = return i

val undefined_list : forall 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval 'a 'e. 'a -> monad 'abort 'barrier 'cache_op 'fault 'pa 'tlb_op 'translation_summary 'arch_ak 'regval (list 'a) 'e
let undefined_list a = return []

